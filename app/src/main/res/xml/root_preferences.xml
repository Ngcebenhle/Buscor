<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

<!--    Payments info-->

    <Preference
        app:key="@string/loyalty_points"
        app:title="@string/loyalty_points"
        app:summary="@string/loyalty_points"/>

    <Preference
        app:key="@string/transfer"
        app:title="@string/transfer"
        app:summary="@string/transfer"/>

    <Preference
        app:key="@string/payment_method"
        app:title="@string/payment_method"
        app:summary="@string/payment_method"/>

<!--    Settings From here -->

    <ListPreference
        app:key="Language"
        app:title="@string/language"
        app:summary="%s"
        app:entries="@array/preference_entries"
        app:entryValues="@array/preference_values"
        app:defaultValue="option1"/>

    <ListPreference
        app:key="Theme"
        app:title="Theme"
        app:summary="%s"
        app:entries="@array/prefe_entries"
        app:entryValues="@array/prefe_values"
        app:defaultValue="option1"/>

    <SwitchPreferenceCompat
        app:key="@string/notifications"
        app:title="@string/notifications"/>

    <Preference
        app:key="@string/cards"
        app:title="@string/cards"
        app:summary="@string/cards"/>

    <Preference
        app:key="@string/contact_support"
        app:title="@string/contact_support"
        app:summary="@string/contact_support"/>

<!--    Customer Support-->

    <Preference
        app:key="@string/help"
        app:title="@string/help"
        app:summary="@string/help"/>

    <Preference
        app:key="@string/sing_out"
        app:title="@string/sing_out"
        app:summary="@string/sing_out"/>

</PreferenceScreen>