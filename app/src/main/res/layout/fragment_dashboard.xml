<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.Dashboard.Dashboard"

    >

    <!-- For Mapbox v10+ -->
    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="500dp"
       />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
       >


        <EditText
            android:layout_width="300dp"
            android:layout_height="27dp"
            android:background="@drawable/edit_text_border"
            android:layout_gravity="center"
            android:text="Search"
            />


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="274dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dashboardScheduleButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_border"
                android:src="@drawable/documents" />

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"

                >

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/dashboard_side_panel_item_border"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dashboardSearchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/search" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="3dp"
                        android:text="Search"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/dashboard_side_panel_item_border"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dashboardBusButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/bus_svgrepo_com" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="3dp"
                        android:text="Search"
                        android:textSize="10sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/dashboard_side_panel_item_border"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/dashboardTicketButton"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ticket_svgrepo_com" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="3dp"
                        android:text="Search"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|right"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/dashboardLogInButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_border"
                android:src="@drawable/outline_account_circle_24" />

            <ImageView
                android:id="@+id/dashboardSettingsButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_border"
                android:src="@drawable/settings_svgrepo_com" />


            <ImageView
                android:id="@+id/dashboardTripButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/button_border"
                android:src="@drawable/location_pin_svgrepo_com" />

        </LinearLayout>


    </FrameLayout>

    </LinearLayout>

    <!-- Overlay View: Positioned at the bottom center -->
    <LinearLayout
        android:layout_width="350dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        android:background="@android:color/transparent">

        <ImageView
            android:id="@+id/dashboardMapsButton"
            android:layout_width="116.67dp"
            android:layout_height="wrap_content"
            android:src="@drawable/maps"/>

        <ImageView
            android:id="@+id/dashboardQRcodeButton"
            android:layout_width="116.67dp"
            android:layout_height="wrap_content"
            android:src="@drawable/qrcode"/>

        <ImageView
            android:id="@+id/dashboardTripLogsButton"
            android:layout_width="116.67dp"
            android:layout_height="wrap_content"
            android:src="@drawable/records_svgrepo_com"/>

    </LinearLayout>





</FrameLayout>